#!/bin/sh
# Stands in for wg off the hub: logs each call, numbers each key by the log line that made it,
# and reads peer handshakes from $dir/handshakes.
dir=${POSTERN_DIR:-.dev}
echo "wg $*" >> "$dir/wg.log"
case $1 in
  genkey) echo "private$(wc -l < "$dir/wg.log" | tr -d ' ')" ;;
  pubkey) sed 's/^private/public/' ;;
  show)
    case $3 in
      public-key) echo 'hubpublic' ;;
      latest-handshakes) cat "$dir/handshakes" 2>/dev/null || true ;;
    esac ;;
esac
