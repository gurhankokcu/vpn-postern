#!/bin/sh
# Stands in for wg off the hub: logs each call, and numbers each key by the log line that made it.
echo "wg $*" >> "$POSTERN_DIR/wg.log"
case $1 in
  genkey) echo "private$(wc -l < "$POSTERN_DIR/wg.log" | tr -d ' ')" ;;
  pubkey) sed 's/^private/public/' ;;
  show) echo 'hubpublic' ;;
esac
