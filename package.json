{
  "name": "vpn-postern",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' 'src/*.test.ts'",
    "cert": "node src/cert.ts",
    "set-password": "node src/set-password.ts",
    "nft": "PATH=dev/bin:$PATH node src/nft.ts",
    "server": "PATH=dev/bin:$PATH node src/server.ts",
    "sim:up": "docker compose -f test/sim/compose.yaml up -d --build --wait",
    "sim:verify": "node test/sim/verify.ts",
    "sim:down": "docker compose -f test/sim/compose.yaml down",
    "e2e": "npm run sim:down && npm run sim:up && node --test --test-concurrency=1 'test/e2e/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
